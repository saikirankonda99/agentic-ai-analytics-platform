APP_ENV=development
# Development only: admin/admin123, analyst/analyst123, viewer/viewer123.
# Production requires AUTH_USERS with explicit password_hash values.
# Generate hashes with backend.auth_sessions.hash_password; see docs/deployment.md.
AUTH_USERS=
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
STREAMLIT_SERVER_PORT=8501

OPENAI_API_KEY=

DATABASE_URL=sqlite:///data/platform_persistence.db
# WORKFLOW_DATABASE_URL is the single source of truth for workflow history, events, telemetry, agents, and usage.
# If unset, workflow persistence falls back to DATABASE_URL for compatibility.
WORKFLOW_DATABASE_URL=sqlite:///data/workflow_runtime.db
# Optional analytical database; use a read-only role, separate from platform storage.
POSTGRES_URL=
POSTGRES_ORGANIZATION_ID=
POSTGRES_WORKSPACE_IDS=[]
ANALYTICS_CONNECTORS_JSON=[]
REDIS_URL=
VECTOR_DATABASE_URL=

# Docker Compose requires a URL-safe password and explicit AUTH_USERS hashes.
POSTGRES_PASSWORD=
# Development drains jobs locally; production must run python -m backend.workers.
ANALYTICS_WORKER_MODE=external
WORKER_LEASE_SECONDS=120
MAX_PENDING_JOBS_PER_WORKSPACE=10
HISTORY_RETENTION_DAYS=30
SAVED_REPORT_RETENTION_DAYS=90

ORCHESTRATION_QUEUE=orchestration.workflows
WEBSOCKET_CHANNEL_PREFIX=workflow
